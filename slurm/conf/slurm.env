# slurm/conf/slurm.env — everything that is true only on Explorer.
# The job scripts contain no paths; they read them from here.
PARTITION=courses
ACCOUNT=binf6610.202710
USER=${USER:-$(id -un)}                                   # a job may start without $USER set
HOME=${HOME:-$(getent passwd "$(id -un)" | cut -d: -f6)}
SAMPLESHEET=/courses/BINF6610.202710/data/samplesheet-variant8.csv
CONDA_ENV=/courses/BINF6610.202710/shared/env/binf6610
PIPELINE_DIR=${HOME}/BINF6610                             # where you git-cloned the repository
RUN_ROOT=/scratch/${USER}/w2-run${RUN_TAG:+-${RUN_TAG}}   # RUN_TAG only for test runs
