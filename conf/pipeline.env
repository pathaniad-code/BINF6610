# conf/pipeline.env
# Sourced by every stage script. Only two values change between the smoke
# run (this week, on a laptop) and the cohort run (next week, on Explorer):
# REF and REGION. Nothing else in the codebase should mention either one.

# This week: the smoke dataset. Point this at the absolute path of smoke.fa.
REF="${REF:-$PWD/smoke.fa}"

# This week: the whole smoke contig. Next week: chr20:1-10000000
REGION="${REGION:-smoke_1mb}"

# Tool locations. Edit these once per machine.
GATK="${GATK:-gatk}"
THREADS="${THREADS:-4}"
